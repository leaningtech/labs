---
// The panel the CheerpJ docs' "AI agents" button (AgentButton) opens: the prompt that
// points a coding agent at the CheerpJ skill, the skill's install command, and
// links for agents. The prompt is cheerpj.com's header prompt (leaningtech.com:
// sites/cheerpj/src/lib/agent-prompt.ts, job "run"); keep the two in step.
//
// The panel is a native popover: it opens in the top layer, so the nav's
// overflow-hidden doesn't clip it, and closes on Esc or a click outside.
// It comes before <main> in the HTML, so agents reading the page see it early.
// CheerpJ docs only: the styles need .site-cheerpj.
import { Icon } from "astro-icon/components";

const skill = "https://cheerpj.com/skills/cheerpj/SKILL.md";
const prompt = `Use the CheerpJ skill (${skill}) to help me run our Java application in the browser.`;
const install = "npx skills add leaningtech/skills --skill cheerpj";
---

<div id="cj-agents" popover class="cj-agents">
	<button
		type="button"
		class="cj-agents-close"
		popovertarget="cj-agents"
		popovertargetaction="hide"
		aria-label="Close"
	>
		<Icon name="mdi:close" aria-hidden="true" />
	</button>
	<p class="cj-agents-title">Use CheerpJ with a coding agent</p>
	<p>
		Give your agent this prompt. It loads the CheerpJ skill, which covers
		converting Java applications, applets, JNLP, Oracle Forms and libraries, and
		the common errors.
	</p>
	<div class="cj-agents-code" data-copy-box>
		<code>{prompt}</code>
		<button type="button" data-copy={prompt} aria-label="Copy the prompt">
			<Icon name="mdi:content-copy" class="cj-agents-idle" aria-hidden="true" />
			<Icon name="mdi:check" class="cj-agents-done" aria-hidden="true" />
		</button>
	</div>
	<p class="cj-agents-label">Or install the skill</p>
	<div class="cj-agents-code" data-copy-box>
		<code>{install}</code>
		<button
			type="button"
			data-copy={install}
			aria-label="Copy the install command"
		>
			<Icon name="mdi:content-copy" class="cj-agents-idle" aria-hidden="true" />
			<Icon name="mdi:check" class="cj-agents-done" aria-hidden="true" />
		</button>
	</div>
	<ul class="cj-agents-links">
		<li><a href={skill}>Read the skill</a></li>
		<li>
			Are you an AI agent? <a href="https://cheerpj.com/agents.md">Read this</a>
		</li>
	</ul>
</div>

<style>
	/* Under the nav, at its right edge. It is taller than a phone held sideways,
	   and fixed, so without a cap the links and the install command below the
	   fold could not be reached: 4.5rem of nav above, 1rem of air below. */
	.cj-agents {
		position: fixed;
		inset: 4.5rem 1rem auto auto;
		width: min(28rem, calc(100vw - 2rem));
		max-height: calc(100vh - 5.5rem);
		max-height: calc(100dvh - 5.5rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		margin: 0;
		padding: 20px;
		border: 1px solid var(--cj-line);
		border-radius: 12px;
		background: var(--cj-dark-grey);
		color: var(--color-bg-300);
		box-shadow: 0 16px 40px rgb(0 0 0 / 0.45);
		font-size: 14px;
		line-height: 1.5;
		white-space: normal;
	}
	.cj-agents p {
		margin: 0 0 12px;
	}
	.cj-agents-title {
		color: var(--cj-ink);
		font-size: 16px;
		font-weight: 700;
	}
	.cj-agents-close {
		position: absolute;
		top: 12px;
		right: 12px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 6px;
		color: var(--color-bg-300);
		transition: color 0.15s ease;
	}
	.cj-agents-close:hover {
		color: var(--cj-ink);
	}
	.cj-agents-close svg {
		width: 18px;
		height: 18px;
	}
	.cj-agents-label {
		margin-top: 16px !important;
		color: var(--cj-ink);
		font-weight: 700;
	}
	.cj-agents-code {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 10px 10px 10px 12px;
		border-radius: 8px;
		background: var(--cj-charcoal);
	}
	.cj-agents-code code {
		flex: 1;
		min-width: 0;
		color: var(--cj-warm-white);
		font-family: var(--cj-font-mono);
		font-size: 13px;
		overflow-wrap: anywhere;
	}
	.cj-agents-code button {
		position: relative;
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border: 1px solid var(--cj-line);
		border-radius: 6px;
		color: var(--cj-ink);
	}
	.cj-agents-code button:hover {
		border-color: var(--cj-ink);
	}
	.cj-agents-code button svg {
		width: 14px;
		height: 14px;
		transition: opacity 0.12s ease;
	}
	/* The tick sits on top of the copy icon and the two fade past each other.
	   Neither is display:none, so the icons' shared <symbol> sprites stay in the
	   document for the other button's <use> to point at. */
	.cj-agents-code button .cj-agents-done {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
		opacity: 0;
	}
	.cj-agents-code button[data-done] .cj-agents-idle {
		opacity: 0;
	}
	.cj-agents-code button[data-done] .cj-agents-done {
		opacity: 1;
	}
	/* One link at each edge, lining up with the code blocks' edges */
	.cj-agents-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 6px 20px;
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
	}
	.cj-agents-links a {
		color: var(--cj-orange);
		font-weight: 700;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.cj-agents-links a:hover {
		color: var(--color-bg-300);
	}
</style>

<script>
	// Copy buttons: copy the text and tick for two seconds. Where the clipboard
	// is barred, select the text instead, for the reader to copy by hand, and
	// don't tick: nothing was copied.
	for (const button of document.querySelectorAll<HTMLButtonElement>(
		"#cj-agents [data-copy]"
	)) {
		const text = button.dataset.copy ?? "";
		button.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				const code = button.closest("[data-copy-box]")?.querySelector("code");
				if (code) getSelection()?.selectAllChildren(code);
				return;
			}
			button.dataset.done = "";
			setTimeout(() => delete button.dataset.done, 2000);
		});
	}
</script>
