---
// The panel the docs' "AI agents" button (AgentButton) opens: the prompt that
// points a coding agent at the product's skill, the skill's install command,
// and links for agents. The text is per product, in lib/agents.ts; the prompt
// matches the marketing site's header prompt (leaningtech.com:
// sites/<product>/src/lib/agent-prompt.ts); keep the two in step.
//
// The panel is a native popover: it opens in the top layer, so the nav's
// overflow-hidden doesn't clip it, and closes on Esc or a click outside.
// It comes before <main> in the HTML, so agents reading the page see it early
// (and the Markdown twin, made from <main>, leaves it out).
import { Icon } from "astro-icon/components";
import type { AgentConfig } from "../../lib/agents";

interface Props {
	agent: AgentConfig;
}

const { agent } = Astro.props;
const { skill, prompt } = agent;
const install = `npx skills add leaningtech/skills --skill ${agent.skillName}`;
---

<div id="agents-panel" popover class="agents-panel">
	<button
		type="button"
		class="agents-close"
		popovertarget="agents-panel"
		popovertargetaction="hide"
		aria-label="Close"
	>
		<Icon name="mdi:close" aria-hidden="true" />
	</button>
	<p class="agents-title">Use {agent.name} with a coding agent</p>
	<p>
		Give your agent this prompt. It loads the {agent.name} skill, which covers
		{agent.covers}.
	</p>
	<div class="agents-code" data-copy-box>
		<code>{prompt}</code>
		<button type="button" data-copy={prompt} aria-label="Copy the prompt">
			<Icon name="mdi:content-copy" class="agents-idle" aria-hidden="true" />
			<Icon name="mdi:check" class="agents-done" aria-hidden="true" />
		</button>
	</div>
	<p class="agents-label">Or install the skill</p>
	<div class="agents-code" data-copy-box>
		<code>{install}</code>
		<button
			type="button"
			data-copy={install}
			aria-label="Copy the install command"
		>
			<Icon name="mdi:content-copy" class="agents-idle" aria-hidden="true" />
			<Icon name="mdi:check" class="agents-done" aria-hidden="true" />
		</button>
	</div>
	<ul class="agents-links">
		<li><a href={skill}>Read the skill</a></li>
		<li>
			Are you an AI agent? <a href={agent.agentsMd}>Read this</a>
		</li>
	</ul>
</div>

<style is:global>
	/* The button's and the panel's colours, per site. The CheerpJ values are
	   cheerpj.com's brand (cheerpj-brand.css); the others follow the theme. */
	:root {
		--ag-ink: #fff;
		--ag-line: rgb(255 255 255 / 0.16);
		--ag-panel: var(--color-bg-800);
		--ag-code-bg: var(--color-bg-950);
		--ag-code-ink: rgb(255 255 255 / 0.9);
		--ag-accent: var(--color-primary-400);
		--ag-mono: var(--font-mono, ui-monospace, monospace);
		--ag-radius: 8px;
		--ag-panel-radius: 16px;
		--ag-weight: 600;
	}
	.site-cheerpj {
		--ag-ink: var(--cj-ink);
		--ag-line: var(--cj-line);
		--ag-panel: var(--cj-dark-grey);
		--ag-code-bg: var(--cj-charcoal);
		--ag-code-ink: var(--cj-warm-white);
		--ag-accent: var(--cj-orange);
		--ag-mono: var(--cj-font-mono);
		--ag-radius: 6px;
		--ag-panel-radius: 12px;
		--ag-weight: 700;
	}
</style>

<style>
	/* Under the nav, at its right edge. It is taller than a phone held sideways,
	   and fixed, so without a cap the links and the install command below the
	   fold could not be reached: 4.5rem of nav above, 1rem of air below. */
	.agents-panel {
		position: fixed;
		inset: 4.5rem 1rem auto auto;
		width: min(28rem, calc(100vw - 2rem));
		max-height: calc(100vh - 5.5rem);
		max-height: calc(100dvh - 5.5rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		margin: 0;
		padding: 20px;
		border: 1px solid var(--ag-line);
		border-radius: var(--ag-panel-radius);
		background: var(--ag-panel);
		color: var(--color-bg-300);
		box-shadow: 0 16px 40px rgb(0 0 0 / 0.45);
		font-size: 14px;
		line-height: 1.5;
		white-space: normal;
	}
	.agents-panel p {
		margin: 0 0 12px;
	}
	.agents-title {
		color: var(--ag-ink);
		font-size: 16px;
		font-weight: var(--ag-weight);
	}
	.agents-close {
		position: absolute;
		top: 12px;
		right: 12px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 6px;
		color: var(--color-bg-300);
		transition: color 0.15s ease;
	}
	.agents-close:hover {
		color: var(--ag-ink);
	}
	.agents-close svg {
		width: 18px;
		height: 18px;
	}
	.agents-label {
		margin-top: 16px !important;
		color: var(--ag-ink);
		font-weight: var(--ag-weight);
	}
	.agents-code {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 10px 10px 10px 12px;
		border-radius: 8px;
		background: var(--ag-code-bg);
	}
	.agents-code code {
		flex: 1;
		min-width: 0;
		color: var(--ag-code-ink);
		font-family: var(--ag-mono);
		font-size: 13px;
		overflow-wrap: anywhere;
	}
	.agents-code button {
		position: relative;
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border: 1px solid var(--ag-line);
		border-radius: 6px;
		color: var(--ag-ink);
	}
	.agents-code button:hover {
		border-color: var(--ag-ink);
	}
	.agents-code button svg {
		width: 14px;
		height: 14px;
		transition: opacity 0.12s ease;
	}
	/* The tick sits on top of the copy icon and the two fade past each other.
	   Neither is display:none, so the icons' shared <symbol> sprites stay in the
	   document for the other button's <use> to point at. */
	.agents-code button .agents-done {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
		opacity: 0;
	}
	.agents-code button[data-done] .agents-idle {
		opacity: 0;
	}
	.agents-code button[data-done] .agents-done {
		opacity: 1;
	}
	/* One link at each edge, lining up with the code blocks' edges */
	.agents-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 6px 20px;
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
	}
	.agents-links a {
		color: var(--ag-accent);
		font-weight: var(--ag-weight);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.agents-links a:hover {
		color: var(--color-bg-300);
	}
</style>

<script>
	// Copy buttons: copy the text and tick for two seconds. Where the clipboard
	// is barred, select the text instead, for the reader to copy by hand, and
	// don't tick: nothing was copied.
	for (const button of document.querySelectorAll<HTMLButtonElement>(
		"#agents-panel [data-copy]"
	)) {
		const text = button.dataset.copy ?? "";
		button.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				const code = button.closest("[data-copy-box]")?.querySelector("code");
				if (code) getSelection()?.selectAllChildren(code);
				return;
			}
			button.dataset.done = "";
			setTimeout(() => delete button.dataset.done, 2000);
		});
	}
</script>
