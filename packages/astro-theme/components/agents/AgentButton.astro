---
// The "AI agents" button that opens AgentMenu's panel. Two copies, as the nav
// is full on phones: in the nav from 640px (icon only up to 1023px), and in
// the bar under the nav, beside the breadcrumbs, below 640px.
// It opens a panel, where Discord and GitHub lead somewhere else, so a rule
// sits between it and that pair.
// Shown for the products with an entry in lib/agents.ts. Colours come from the
// --ag-* variables set per site in AgentMenu (CheerpJ's brand, or the theme's).
import { Icon } from "astro-icon/components";

interface Props {
	where: "nav" | "bar";
}

const { where } = Astro.props;
---

<button
	type="button"
	class:list={["agents-btn", `agents-btn-${where}`]}
	popovertarget="agents-panel"
	aria-label="AI agents"
>
	<Icon name="ph:robot" aria-hidden="true" />
	<span class="agents-btn-text">AI agents</span>
</button>
{where === "nav" && <span class="agents-rule" aria-hidden="true" />}

<style>
	/* Like the nav's Discord and GitHub buttons, with a label */
	.agents-btn {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 6px;
		height: 2rem;
		padding: 0 10px;
		border: 1px solid var(--ag-line);
		border-radius: var(--ag-radius);
		color: var(--ag-ink);
		font-size: 14px;
		font-weight: var(--ag-weight);
		transition: border-color 0.15s ease;
	}
	.agents-btn:hover {
		border-color: var(--ag-ink);
	}
	.agents-btn svg {
		width: 18px;
		height: 18px;
	}

	/* Between this and the Discord and GitHub pair, which it is not one of */
	.agents-rule {
		flex: none;
		width: 1px;
		height: 1.25rem;
		background: var(--ag-line);
	}
	@media (max-width: 639px) {
		.agents-rule {
			display: none;
		}
	}

	.agents-btn-bar {
		margin-left: auto;
	}
	@media (min-width: 640px) {
		.agents-btn-bar {
			display: none;
		}
	}
	@media (max-width: 639px) {
		.agents-btn-nav {
			display: none;
		}
	}
	@media (min-width: 640px) and (max-width: 1023px) {
		.agents-btn-nav {
			width: 2rem;
			padding: 0;
			justify-content: center;
		}
		.agents-btn-nav .agents-btn-text {
			display: none;
		}
	}
</style>
