---
import { type ProductData } from "../../../lib/products";
import { Image } from "astro:assets";
import Search from "../../search/Search.astro";
import { DISCORD_URL } from "../../../consts";
import { Icon } from "astro-icon/components";
import ProductVersionSwitcher from "../../ProductVersionSwitcher.astro";
import GitHubStarCount from "../GitHubStarCount.svelte";
import DiscordPresenceCount from "../DiscordPresenceCount.svelte";
import Link from "./Link.astro";
import { getLocalisedProductNav, getRootNav } from "../../../lib/nav";
import { t } from "../../../lib/i18n";

interface Props {
	product: ProductData;
}

const { product } = Astro.props;

const firstDocsEntry = getLocalisedProductNav(
	await getRootNav(),
	product.id,
	Astro.currentLocale
)[0];
if (!firstDocsEntry) throw new Error("must have a docs entry");
const productFilterTag: Partial<Record<string, string>> = {
	cheerp: "Cheerp",
	cheerpj2: "CheerpJ",
	cheerpj3: "CheerpJ",
	cheerpx: "CheerpX",
	"cheerpx-for-flash": "CheerpX",
	"cheerpx-games-runner": "CheerpX",
	browserpod: "BrowserPod",
};
const filterParam = productFilterTag[product.id]
	? `?product=${productFilterTag[product.id]}`
	: "";
let blogref = `https://labs.leaningtech.com/blog${filterParam}`;
let showcaseref = `https://labs.leaningtech.com/showcase${filterParam}`;
---

<nav
	aria-label="Product navigation"
	class="sticky top-0 z-40 bg-bg-900 text-white font-medium leading-6 border-b border-b-transparent shadow-none transition-all duration-200"
	id="product-nav"
>
	{
		product.id === "browserpod" && (
			<div class="header-glare-container" aria-hidden="true">
				<div class="header-glare" id="header-glare" />
			</div>
		)
	}
	<div
		class="max-w-screen-2xl w-full mx-auto h-16 px-4 sm:px-6 md:px-8 py-4 flex items-center justify-between gap-4 whitespace-nowrap overflow-hidden relative z-10"
	>
		<div class="flex gap-4 flex-none lg:basis-64 lg:mr-10 justify-between">
			<a href={product.href} class="flex items-center">
				<Image src={product.logotype} alt={product.name} class="w-auto h-8" />
			</a>
			{
				(product.id.match("cheerpj2") || product.id.match("cheerpj3")) && (
					<ProductVersionSwitcher {product} />
				)
			}
		</div>

		<div class="grow lg:hidden"></div>

		<Search filterProductId={product.id} />

		<div class="flex items-stretch gap-2 ml-auto px-2 relative" id="nav-items">
			{
				product.id === "browserpod" && (
					<div class="active-pill" id="active-pill" />
				)
			}
			<Link label={t("Docs", Astro.currentLocale)} href={firstDocsEntry.href} />
			<Link label={t("Blog", Astro.currentLocale)} href={blogref} />
			<Link label={t("Demos", Astro.currentLocale)} href={showcaseref} />
			{
				product.id.match("cheerpx") && (
					<Link
						label={t("Licensing", Astro.currentLocale)}
						href={"/licensing"}
					/>
				)
			}
		</div>

		<div class="flex items-center gap-4 flex-none text-bg-200">
			<a
				href={DISCORD_URL}
				class="flex items-center gap-1.5 hover:text-white group"
			>
				<Icon name="fa-brands:discord" class="w-5 h-5" />
				<span
					class="hidden md:flex items-center gap-1 text-bg-400 group-hover:text-white"
					title="Online Discord members"
				>
					<Icon
						name="ph:circle-fill"
						class="w-3 h-3 text-green-500 absolute animate-ping opacity-50"
					/>
					<Icon name="ph:circle-fill" class="w-3 h-3 text-green-500" />
					<DiscordPresenceCount client:only="svelte" />
				</span>
			</a>
			<a
				href={product.github}
				class="rounded-md flex items-center justify-middle py-1 px-2 gap-2 hover:text-white group"
			>
				<Icon name="fa-brands:github" class="w-5 h-5" />
				<span
					class="hidden md:flex items-center gap-1 text-bg-400 group-hover:text-white"
					title="GitHub stars"
				>
					<Icon name="ph:star-fill" class="w-4 h-4" />
					<GitHubStarCount
						client:only="svelte"
						repo={`leaningtech/${product.repositoryName}`}
					/>
				</span>
			</a>
		</div>
	</div>
</nav>

<script>
	// add shadow and border when scrolling

	const nav = document.getElementById("product-nav")!;
	const classes = ["!border-b-bg-800", "!shadow-lg"];

	function handleScroll() {
		if (window.scrollY > 64) {
			nav.classList.add(...classes);
		} else {
			nav.classList.remove(...classes);
		}
	}

	window.addEventListener("scroll", handleScroll, { passive: true });
	// Hover pill (browserpod only; safely no-ops elsewhere since #active-pill won't exist)
	const navItems = document.getElementById("nav-items");
	const activePill = document.getElementById("active-pill");
	const navButtons = document.querySelectorAll<HTMLElement>("[data-navpill]");

	function movePillTo(btn: HTMLElement) {
		if (!activePill || !navItems) return;
		const itemRect = navItems.getBoundingClientRect();
		const btnRect = btn.getBoundingClientRect();
		activePill.style.width = `${btnRect.width}px`;
		activePill.style.transform = `translateX(${btnRect.left - itemRect.left}px)`;
		activePill.style.opacity = "1";
	}

	navButtons.forEach((btn) => {
		btn.addEventListener("mouseenter", () => movePillTo(btn));
	});

	navItems?.addEventListener("mouseleave", () => {
		if (activePill) activePill.style.opacity = "0";
	});

	const glare = document.getElementById("header-glare");

	nav.addEventListener("mousemove", (e) => {
		if (!glare) return;
		const rect = nav.getBoundingClientRect();
		const x = e.clientX - rect.left;
		const y = e.clientY - rect.top;
		glare.style.setProperty("--x", `${x}px`);
		glare.style.setProperty("--y", `${y}px`);
	});
</script>

<style>
	:global(.site-browserpod) #product-nav {
		background: rgba(13, 13, 14, 0.45);
		backdrop-filter: blur(50px) saturate(200%);
		-webkit-backdrop-filter: blur(50px) saturate(200%);
		box-shadow:
			0 40px 80px -20px rgba(0, 0, 0, 0.8),
			0 10px 30px -10px rgba(0, 0, 0, 0.8),
			inset 0 2px 3px -1px rgba(255, 255, 255, 0.25),
			inset 0 -2px 4px -1px rgba(255, 255, 255, 0.05),
			inset 0 0 0 1px rgba(255, 255, 255, 0.15);
	}

	:global(.site-browserpod) .active-pill {
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		opacity: 0;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 99px;
		box-shadow:
			inset 0 1px 1px rgba(255, 255, 255, 0.1),
			inset 0 0 0 1px rgba(255, 255, 255, 0.08);
		transition:
			transform 0.35s cubic-bezier(0.34, 1.2, 0.64, 1),
			width 0.35s cubic-bezier(0.34, 1.2, 0.64, 1),
			opacity 0.25s ease;
		z-index: 1;
	}

	:global(.site-browserpod) .nav-btn {
		position: relative;
		z-index: 2;
	}

	:global(.site-browserpod) .header-glare-container {
		position: absolute;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
		z-index: 5;
	}

	:global(.site-browserpod) .header-glare {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.3s ease;
		background: radial-gradient(
			circle 90px at var(--x, 50%) var(--y, 50%),
			rgba(255, 255, 255, 0.15) 0%,
			transparent 100%
		);
		mix-blend-mode: overlay;
	}

	:global(.site-browserpod) #product-nav:hover .header-glare {
		opacity: 1;
	}
</style>
