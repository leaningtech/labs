---
import { type ProductData } from "../../../lib/products";
import { Image } from "astro:assets";
import Search from "../../search/Search.astro";
import { DISCORD_URL } from "../../../consts";
import { Icon } from "astro-icon/components";
import GitHubStarCount from "../GitHubStarCount.svelte";
import DiscordPresenceCount from "../DiscordPresenceCount.svelte";
import Link from "./Link.astro";
import CheerpjLogo from "../../../cheerpj-brand/cheerpj-logo.svg";
import { getProductNav, getRootNav } from "../../../lib/nav";

interface Props {
	product: ProductData;
	wide?: boolean; // full width instead of max-w-screen-2xl
}

const { product, wide = false } = Astro.props;
// cheerpj.com's header, with search beside the logo and boxed icons.
// Every page of that site is under /docs/, so its Docs button is always active.
const isCheerpj = product.id === "cheerpj3";

const firstDocsEntry = getProductNav(await getRootNav(), product.id)[0];
if (!firstDocsEntry) throw new Error("must have a docs entry");
const productFilterTag: Partial<Record<string, string>> = {
	cheerp: "Cheerp",
	cheerpj3: "CheerpJ",
	cheerpx: "CheerpX",
	"cheerpx-for-flash": "CheerpX",
	"cheerpx-games-runner": "CheerpX",
	browserpod: "BrowserPod",
};
const filterParam = productFilterTag[product.id]
	? `?product=${productFilterTag[product.id]}`
	: "";
let blogref = `https://labs.leaningtech.com/blog${filterParam}`;
let showcaseref = `https://labs.leaningtech.com/showcase${filterParam}`;
---

<nav
	aria-label="Product navigation"
	class="sticky top-0 z-40 bg-bg-900 text-white font-medium leading-6 border-b border-b-transparent shadow-none transition-all duration-200"
	id="product-nav"
>
	<svg style="display: none;" aria-hidden="true">
		<filter id="nav-glass-distortion" x="0%" y="0%" width="100%" height="100%">
			<feTurbulence
				type="fractalNoise"
				baseFrequency="0.008 0.008"
				numOctaves="2"
				seed="92"
				result="noise"></feTurbulence>
			<feGaussianBlur in="noise" stdDeviation="2" result="blurred"
			></feGaussianBlur>
			<feDisplacementMap
				in="SourceGraphic"
				in2="blurred"
				scale="70"
				xChannelSelector="R"
				yChannelSelector="G"></feDisplacementMap>
		</filter>
	</svg>
	<div class="glass-filter" id="nav-glass-filter"></div>
	<div class="glass-tint"></div>

	<div
		class:list={[
			"w-full mx-auto px-4 sm:px-6 md:px-8 flex items-center justify-between gap-4 whitespace-nowrap overflow-hidden relative z-10",
			product.id === "browserpod" ? "h-12" : "h-16 py-4",
			isCheerpj && "max-sm:gap-2",
			!wide && "max-w-screen-2xl",
		]}
	>
		<div
			class:list={[
				"flex gap-4 flex-none justify-between",
				product.id === "browserpod"
					? "lg:mr-4"
					: isCheerpj
						? "mr-2"
						: "lg:basis-64 lg:mr-10",
			]}
		>
			<a href={product.href} class="flex items-center">
				{
					isCheerpj ? (
						<CheerpjLogo
							role="img"
							aria-label={product.name}
							class="cj-nav-logo"
						/>
					) : (
						<Image
							src={product.logotype}
							alt={product.name}
							class:list={[
								product.id === "browserpod" ? "w-[100px] h-auto" : "w-auto h-8",
							]}
						/>
					)
				}
			</a>
		</div>

		{!isCheerpj && <div class="grow lg:hidden" />}
		<Search filterProductId={product.id} />
		{isCheerpj && <div class="grow" />}

		<div
			class:list={[
				"flex items-stretch gap-2 relative",
				isCheerpj ? "max-sm:gap-1" : "ml-auto px-2",
			]}
			id="nav-items"
		>
			<Link
				label="Docs"
				href={firstDocsEntry.href}
				showHoverBg={product.id !== "browserpod"}
				cheerpj={product.id === "cheerpj3"}
				active={isCheerpj || undefined}
			/>
			<Link
				label="Blog"
				href={blogref}
				showHoverBg={product.id !== "browserpod"}
				cheerpj={product.id === "cheerpj3"}
			/>
			<Link
				label="Demos"
				href={showcaseref}
				showHoverBg={product.id !== "browserpod"}
				cheerpj={product.id === "cheerpj3"}
			/>
			{
				product.id.match("cheerpx") && (
					<Link
						label="Licensing"
						href={"/licensing"}
						showHoverBg={product.id !== "browserpod"}
					/>
				)
			}
		</div>

		{
			isCheerpj ? (
				<div class="flex items-center gap-2 flex-none">
					<a href={DISCORD_URL} class="cj-icon-btn">
						<span class="sr-only">Discord</span>
						<Icon name="ri:discord-fill" aria-hidden="true" />
						<span class="cj-icon-count" title="Online Discord members">
							<Icon name="ph:circle-fill" class="text-green-500" />
							<DiscordPresenceCount client:only="svelte" />
						</span>
					</a>
					<a href={product.github} class="cj-icon-btn">
						<span class="sr-only">GitHub</span>
						<Icon name="ri:github-fill" aria-hidden="true" />
						<span class="cj-icon-count" title="GitHub stars">
							<Icon name="ph:star-fill" class="text-primary-500" />
							<GitHubStarCount
								client:only="svelte"
								repo={`leaningtech/${product.repositoryName}`}
							/>
						</span>
					</a>
				</div>
			) : (
				<div class="flex items-center gap-4 flex-none text-bg-200">
					<a
						href={DISCORD_URL}
						class="nav-icon-link flex items-center gap-1.5 hover:text-white group"
					>
						<Icon
							name={
								product.id === "browserpod"
									? "mingcute:discord-fill"
									: "fa-brands:discord"
							}
							class="w-5 h-5"
							is:inline
						/>
						<span
							class="hidden md:flex items-center gap-1 text-bg-400 group-hover:text-white nav-icon-count"
							title="Online Discord members"
						>
							<Icon name="ph:circle-fill" class="w-3 h-3 text-green-500" />
							<DiscordPresenceCount client:only="svelte" />
						</span>
					</a>
					<a
						href={product.github}
						class="nav-icon-link rounded-md flex items-center justify-middle py-1 px-2 gap-2 hover:text-white group"
					>
						<Icon
							name={
								product.id === "browserpod"
									? "mingcute:github-fill"
									: "fa-brands:github"
							}
						/>
						<span
							class="hidden md:flex items-center gap-1 text-bg-400 group-hover:text-white nav-icon-count"
							title="GitHub stars"
						>
							<Icon name="ph:star-fill" class="w-4 h-4 text-yellow-500" />
							<GitHubStarCount
								client:only="svelte"
								repo={`leaningtech/${product.repositoryName}`}
							/>
						</span>
					</a>
				</div>
			)
		}
	</div>
</nav>

<script>
	// add shadow and border when scrolling

	const nav = document.getElementById("product-nav")!;
	const classes = ["!border-b-bg-800", "!shadow-lg"];
	const isBrowserpod =
		document.documentElement.classList.contains("site-browserpod");

	function handleScroll() {
		if (isBrowserpod) return;
		if (window.scrollY > 64) {
			nav.classList.add(...classes);
		} else {
			nav.classList.remove(...classes);
		}
	}

	window.addEventListener("scroll", handleScroll, { passive: true });

	// Liquid-glass distortion filter; Safari crashes/blanks when pairing
	// backdrop-filter with an SVG filter reference, so feature-detect and skip there
	const glassFilter = document.getElementById("nav-glass-filter");
	if (glassFilter) {
		const ua = navigator.userAgent;
		const isSafari = /^((?!chrome|android|crios|fxios).)*safari/i.test(ua);
		if (!isSafari) {
			glassFilter.style.filter = "url(#nav-glass-distortion) saturate(150%)";
		}
	}
</script>

<style>
	:global(.site-browserpod #product-nav) {
		position: sticky;
		background-color: transparent;
		isolation: isolate;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
		width: calc(100% - 2rem);
		max-width: 1024px;
		margin: 0 auto;
		border-radius: 16px;
		top: 1rem;
	}

	:global(.site-browserpod #product-nav .nav-btn) {
		font-size: 14px;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.6);
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	:global(.site-browserpod #product-nav .nav-btn:hover) {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
	}

	:global(.site-browserpod #product-nav .nav-btn[data-active]) {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
	}

	:global(.site-browserpod #product-nav .nav-icon-link) {
		color: rgba(255, 255, 255, 0.6);
		padding: 0.25rem 0.5rem;
		border-radius: 0.375rem;
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	:global(.site-browserpod #product-nav .nav-icon-link:hover) {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
	}

	:global(.site-browserpod #product-nav .nav-icon-count) {
		color: inherit;
	}

	/* The pill is narrower than the full-width nav, so drop extras before it overflows */
	@media (max-width: 1023px) {
		:global(.site-browserpod #product-nav .nav-icon-count) {
			display: none;
		}
	}

	@media (max-width: 767px) {
		:global(.site-browserpod #product-nav .nav-btn) {
			padding-inline: 0.5rem;
		}
	}

	:global(.site-browserpod) #product-nav site-search {
		height: 2rem;
	}

	:global(.site-browserpod #product-nav site-search button) {
		font-size: 14px;
	}

	:global(.site-browserpod) #product-nav .glass-filter {
		position: absolute;
		inset: 0;
		z-index: 0;
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		pointer-events: none;
	}

	:global(.site-browserpod) #product-nav .glass-tint {
		position: absolute;
		inset: 0;
		z-index: 1;
		background-color: #d7dadd;
		opacity: 0.12;
		pointer-events: none;
	}
</style>
