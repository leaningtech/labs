---
export interface Heading {
	depth: number;
	slug: string;
	text: string;
	subheadings: Heading[];
}

interface Props {
	heading: Heading;
}

const { heading } = Astro.props;
---

<li>
	<a
		href={"#" + heading.slug}
		data-toc-link
		class:list={[
			"block py-1 text-bg-400 hover:text-white",
			{
				"font-medium": heading.depth <= 2,
			},
		]}
	>
		{heading.text}
	</a>

	{
		heading.subheadings.length > 0 && (
			<ol class="pl-4">
				{heading.subheadings.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ol>
		)
	}
</li>

<script>
	const ACTIVE = "!text-primary-400";
	const links = [
		...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
	];
	const headings = links.map((link) =>
		document.getElementById(decodeURIComponent(link.hash.slice(1)))
	);

	function setActive(index: number) {
		links.forEach((link, i) => link.classList.toggle(ACTIVE, i === index));
	}

	// The active section is the last heading above a reading line 1/3 down the window. Near the
	// bottom of the page that line sweeps down to the window's bottom edge, so the last sections,
	// which can never scroll up to 1/3, still get their turn.
	function update() {
		const vh = window.innerHeight;
		const base = vh / 3;
		const remaining =
			document.documentElement.scrollHeight - vh - window.scrollY;
		const sweep = vh - base;
		const line = remaining < sweep ? base + (sweep - remaining) : base;

		let active = 0;
		headings.forEach((heading, i) => {
			if (heading && heading.getBoundingClientRect().top <= line) active = i;
		});
		setActive(active);
	}

	// After a TOC click, keep the clicked section active until the user scrolls again: the page
	// may not be able to scroll that heading up to the reading line.
	let locked = false;
	links.forEach((link, i) =>
		link.addEventListener("click", () => {
			locked = true;
			setActive(i);
		})
	);
	for (const event of ["wheel", "touchmove", "keydown", "pointerdown"]) {
		window.addEventListener(event, () => (locked = false), { passive: true });
	}

	let queued = false;
	window.addEventListener(
		"scroll",
		() => {
			if (locked || queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				update();
			});
		},
		{ passive: true }
	);
	window.addEventListener("resize", update);

	const fromHash = links.findIndex((link) => link.hash === location.hash);
	if (fromHash >= 0) {
		locked = true;
		setActive(fromHash);
	} else if (links.length > 0) {
		update();
	}
</script>
