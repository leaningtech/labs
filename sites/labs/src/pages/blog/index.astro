---
import { getCollection, getEntry } from "astro:content";
import { getImage } from "astro:assets";
import Shell from "@leaningtech/astro-theme/layouts/Shell.astro";
import Footer from "@leaningtech/astro-theme/components/Footer.astro";
import { getSite } from "@leaningtech/astro-theme/nav";
import ProductFilter from "../../components/ProductFilter.svelte";
import { FEED_PRODUCTS, feedPath, feedTitle } from "../../lib/feeds";

const allPosts = (
	await getCollection("blog", ({ data }) => data.draft !== true)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const site = getSite(Astro.site?.hostname);

// Passed to ProductFilter as a prop rather than imported there: feeds.ts pulls in
// @astrojs/rss and astro:content, neither of which can go in the client bundle.
const feeds = [undefined, ...FEED_PRODUCTS].map((product) => ({
	label: product ?? "All posts",
	href: feedPath(product),
	title: feedTitle(product),
}));

const blogCards = await Promise.all(
	allPosts.map(async (post) => {
		const authorEntries = await Promise.all(
			post.data.authors.map((id) => getEntry("blogauthors", id))
		);
		const imageSrc = post.data.heroImage
			? (
					await getImage({
						src: post.data.heroImage,
						width: 1170,
						height: 615,
						format: "webp",
					})
				).src
			: undefined;
		return {
			slug: post.slug,
			title: post.data.title,
			description: post.data.description,
			href: `/blog/${post.slug}`,
			imageSrc,
			tags: post.data.tags ?? [],
			categories: post.data.categories ?? [],
			pubDate: post.data.pubDate.toISOString(),
			authors: authorEntries
				.filter((a) => a !== undefined)
				.map((a) => ({
					name: a.data.name,
					avatarSrc: a.data.avatar?.src,
					guest: a.data.guest ?? false,
				})),
		};
	})
);
---

<Shell
	title="Engineering blog"
	description="Read the latest updates from the Leaning Technologies development team about WebAssembly, compilers, and more."
	{site}
	filterPage={true}
>
	{
		feeds.map((feed) => (
			<link
				slot="head"
				rel="alternate"
				type="application/rss+xml"
				title={feed.title}
				href={feed.href}
			/>
		))
	}
	<div class="bg-stone-950">
		<header class="text-center py-16">
			<h1
				class="text-6xl md:text-7xl font-bold tracking-tight text-balance mb-6 pb-2 bg-linear-to-b/srgb from-white to-stone-400 bg-clip-text text-transparent"
			>
				Engineering blog
			</h1>
			<p class="text-lg text-balance text-stone-400 max-w-xl mx-auto">
				News, technical writeups, and announcements directly from the
				development team.
			</p>
		</header>

		<section
			class="pb-24 px-4 sm:px-8 mx-auto w-full max-w-screen-xl"
			data-filter-section
		>
			<ProductFilter
				client:load
				searchPlaceholder="Search posts…"
				cards={blogCards}
				gridType="blog"
				{feeds}
			/>
		</section>
	</div>

	<Footer />
</Shell>
