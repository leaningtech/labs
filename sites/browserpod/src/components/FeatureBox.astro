---
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details
	{open}
	class="feature-box not-prose group rounded-lg border border-bg-200 bg-bg-50 open:shadow-sm dark:border-bg-800 dark:bg-bg-900/50"
>
	<summary
		class="flex cursor-pointer list-none items-center gap-3 rounded-lg px-4 py-3 font-semibold text-bg-900 transition-colors hover:bg-bg-100 dark:text-bg-100 dark:hover:bg-bg-800/50"
	>
		<span class="grow">{title}</span>
		<Icon
			name="ph:caret-down"
			class="size-4 shrink-0 text-bg-500 transition-transform duration-200 group-open:rotate-180"
		/>
	</summary>
	<div
		class="border-t border-bg-200 px-4 py-3 text-bg-700 dark:border-bg-800 dark:text-bg-300 [&>p]:my-0 [&>p+p]:mt-3"
	>
		<slot />
	</div>
</details>

<style>
	/* Hide the native disclosure triangle (Safari needs the -webkit- rule) */
	.feature-box summary::-webkit-details-marker {
		display: none;
	}
	.feature-box summary::marker {
		content: "";
	}
</style>
